<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_">
      <DataSourceReference>/ConfigMgr_###/{5C6358F2-4BB6-4a1b-A16E-8D96795D8602}</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2c7f8d0a-e235-434e-ad68-4b30bc071bc4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="FailureDevices">
      <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName><QueryParameters><QueryParameter Name="@OSType"><Value>=Parameters!OSType.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT
    vRSV.Netbios_Name0 AS ComputerName,
    CASE WHEN vGOS.ProductType0 = 1 THEN 'Workstation' WHEN vGOS.ProductType0 IN (2,3) THEN 'Server' ELSE 'Unknown' END AS OSType,
    vUI.Title AS UpdateTitle,
    vUCS.LastErrorCode,
    sys.fn_varbintohexstr(vUCS.LastErrorCode) AS LastErrorCode_HEX,
    vUCS.LastEnforcementMessageID,
    vUCS.Status
FROM v_UpdateComplianceStatus vUCS
JOIN v_UpdateInfo vUI ON vUCS.CI_ID = vUI.CI_ID
JOIN v_R_System_Valid vRSV ON vUCS.ResourceID = vRSV.ResourceID
LEFT JOIN v_GS_OPERATING_SYSTEM vGOS ON vUCS.ResourceID = vGOS.ResourceID
WHERE vUCS.Status = 2
  AND vUCS.LastEnforcementMessageID IN (6,11,14)
  AND (@OSType = 'All' OR CASE WHEN vGOS.ProductType0 = 1 THEN 'Workstation' WHEN vGOS.ProductType0 IN (2,3) THEN 'Server' ELSE 'Unknown' END = @OSType)
ORDER BY vRSV.Netbios_Name0, vUI.Title;</CommandText></Query>
      <Fields>
        <Field Name="ComputerName"><DataField>ComputerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OSType"><DataField>OSType</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="UpdateTitle"><DataField>UpdateTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LastErrorCode"><DataField>LastErrorCode</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="LastErrorCode_HEX"><DataField>LastErrorCode_HEX</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LastEnforcementMessageID"><DataField>LastEnforcementMessageID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections><ReportSection><Body><ReportItems>
    <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Software Update Installation Failures by Device</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>0.1in</Top><Left>0.1in</Left><Height>0.3in</Height><Width>9.8in</Width><Style><Border><Style>None</Style></Border></Style></Textbox>
