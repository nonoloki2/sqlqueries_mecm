      <TablixRow><Height>0.25in</Height><TablixCells>
        <TablixCell><CellContents><Textbox Name="hComputer"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Computer</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="hOSType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>OS Type</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="hUpdate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Update Title</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="hHex"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Error HEX</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="hCode"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Error Dec</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
      </TablixCells></TablixRow>
      <TablixRow><Height>0.22in</Height><TablixCells>
        <TablixCell><CellContents><Textbox Name="dComputer"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ComputerName.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="dOSType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OSType.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="dUpdate"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!UpdateTitle.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="dHex"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LastErrorCode_HEX.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="dCode"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LastErrorCode.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
      </TablixCells></TablixRow>
    </TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="Details" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>FailureDevices</DataSetName><Top>0.8in</Top><Left>0.1in</Left><Height>0.47in</Height><Width>9.5in</Width><Style><Border><Style>None</Style></Border></Style></Tablix>
